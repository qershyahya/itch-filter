{
  "manifest_version": 3,
  "name": "itch.io Content Filter",
  "version": "1.0.4",
  "description": "Filters itch.io games, jams, devlogs, collections and comments for a safe, family-friendly environment.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://itch.io/*",
    "*://*.itch.io/*",
    "*://*.itch.zone/*",
    "https://raw.githubusercontent.com/*",
    "https://docs.google.com/*"
  ],
  "background": {
    "scripts": [
      "rules.js",
      "defaultConfig.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://itch.io/*",
        "*://*.itch.io/*"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "itch.io Content Filter — settings",
    "default_popup": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "itch-filter@qershyahya",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
